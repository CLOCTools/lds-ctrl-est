find_package(hdf5 CONFIG REQUIRED)
if(TARGET hdf5::hdf5-shared)
    list(APPEND PROJECT_REQUIRED_LIBRARIES_ABSOLUTE_NAME hdf5::hdf5-shared)
    if(TARGET hdf5::hdf5_hl-shared)
        list(APPEND PROJECT_REQUIRED_LIBRARIES_ABSOLUTE_NAME hdf5::hdf5_hl-shared)
    endif()
elseif(TARGET hdf5::hdf5-static)
    list(APPEND PROJECT_REQUIRED_LIBRARIES_ABSOLUTE_NAME hdf5::hdf5-static)
    if(TARGET hdf5::hdf5_hl-static)
        list(APPEND PROJECT_REQUIRED_LIBRARIES_ABSOLUTE_NAME hdf5::hdf5_hl-static)
    endif()
elseif(TARGET hdf5::hdf5)
    list(APPEND PROJECT_REQUIRED_LIBRARIES_ABSOLUTE_NAME hdf5::hdf5)
else()
    message(FATAL_ERROR "Could not determine if HDF5 libraries are dynamic or static.")
endif()
